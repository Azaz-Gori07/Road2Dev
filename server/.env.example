MONGODB_URL=
PORT=5500

# Optional: override system DNS servers for resolving MongoDB SRV records
# DNS_SERVERS=8.8.8.8,1.1.1.1
JWT_SECRET=

# Zenuxs OAuth
ZENUXS_CLIENT_ID=
ZENUXS_CLIENT_SECRET=
ZENUXS_AUTH_SERVER=

EMAIL_USER=
EMAIL_PASS=

# Primary AI key (used for Groq if starts with gsk_, Gemini if starts with AIza)
AI_API_KEY=

# Secondary AI key (Gemini fallback — must start with "AIza" to be valid)
AI_API_KEY_2=

# Token limits for AI responses
# Groq llama-3.3-70b-versatile: max 8,192 output tokens
# Gemini 2.5 Flash: max 65,536 output tokens
# AI_MAX_OUTPUT_TOKENS=8192
# AI_MAX_TOKENS=8192

# Optional: raises GitHub API rate limits for project defense repo scans
GITHUB_TOKEN=
